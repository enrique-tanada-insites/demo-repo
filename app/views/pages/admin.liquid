---
slug: admin
---
{% raw %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admins</title>
  <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f0f2f5; color: #1a1a2e; min-height: 100vh; }
    .sidebar { position: fixed; top: 0; left: 0; width: 220px; height: 100vh; background: #1a1a2e; padding: 32px 16px; display: flex; flex-direction: column; gap: 8px; }
    .sidebar-logo { font-size: 18px; font-weight: 700; color: #fff; padding: 0 12px 24px; }
    .nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 8px; font-size: 14px; color: #8892a4; cursor: pointer; transition: background 0.15s, color 0.15s; text-decoration: none; }
    .nav-item:hover, .nav-item.active { background: #ffffff14; color: #fff; }
    .nav-item .icon { font-size: 16px; }
    .main { margin-left: 220px; padding: 40px; min-height: 100vh; }
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; }
    .page-title { font-size: 24px; font-weight: 700; color: #1a1a2e; }
    .page-subtitle { font-size: 14px; color: #6b7280; margin-top: 2px; }
    .toolbar { display: flex; align-items: center; gap: 12px; }
    .search-wrap { position: relative; }
    .search-wrap .icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #9ca3af; font-size: 14px; pointer-events: none; }
    .search-input { padding: 8px 12px 8px 34px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; color: #1a1a2e; background: #fff; width: 240px; outline: none; transition: border-color 0.15s; }
    .search-input:focus { border-color: #4f46e5; }
    .btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 8px; font-size: 14px; font-weight: 500; cursor: pointer; border: none; transition: background 0.15s; }
    .btn-primary { background: #4f46e5; color: #fff; } .btn-primary:hover { background: #4338ca; }
    .card { background: #fff; border-radius: 12px; box-shadow: 0 1px 3px rgba(0,0,0,.06); overflow: hidden; }
    table { width: 100%; border-collapse: collapse; }
    thead th { padding: 12px 20px; text-align: left; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #9ca3af; background: #f9fafb; border-bottom: 1px solid #f3f4f6; cursor: pointer; user-select: none; white-space: nowrap; }
    thead th:hover { color: #4f46e5; }
    thead th .sort-icon { display: inline-block; margin-left: 4px; opacity: 0.4; font-size: 10px; }
    thead th.sorted .sort-icon { opacity: 1; color: #4f46e5; }
    tbody tr { border-bottom: 1px solid #f3f4f6; transition: background 0.1s; }
    tbody tr:last-child { border-bottom: none; } tbody tr:hover { background: #f9fafb; }
    td { padding: 14px 20px; font-size: 14px; color: #374151; vertical-align: middle; }
    .admin-cell { display: flex; align-items: center; gap: 12px; }
    .avatar { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 600; color: #fff; flex-shrink: 0; }
    .admin-name { font-weight: 500; color: #1a1a2e; font-size: 14px; } .admin-email { font-size: 12px; color: #9ca3af; margin-top: 1px; }
    .badge { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 20px; font-size: 12px; font-weight: 500; }
    .badge-active { background: #d1fae5; color: #065f46; } .badge-inactive { background: #f3f4f6; color: #6b7280; } .badge-suspended { background: #fee2e2; color: #991b1b; }
    .role-badge { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 6px; font-size: 12px; font-weight: 500; }
    .role-badge.super-admin { background: #fee2e2; color: #991b1b; } .role-badge.admin { background: #ede9fe; color: #5b21b6; } .role-badge.moderator { background: #dbeafe; color: #1e40af; } .role-badge.support { background: #fef3c7; color: #92400e; }
    .access-bar { display: flex; align-items: center; gap: 8px; } .access-track { width: 80px; height: 6px; background: #f3f4f6; border-radius: 99px; overflow: hidden; } .access-fill { height: 100%; border-radius: 99px; background: #4f46e5; } .access-label { font-size: 12px; color: #6b7280; }
    .secondary-text { font-size: 12px; color: #9ca3af; margin-top: 1px; }
    .action-btn { background: none; border: none; cursor: pointer; color: #9ca3af; font-size: 16px; padding: 4px 6px; border-radius: 4px; transition: background 0.1s, color 0.1s; }
    .action-btn:hover { background: #f3f4f6; color: #4f46e5; }
    .table-footer { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; border-top: 1px solid #f3f4f6; font-size: 13px; color: #6b7280; }
    .pagination { display: flex; gap: 4px; }
    .page-btn { width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border-radius: 6px; border: 1px solid #e5e7eb; font-size: 13px; cursor: pointer; background: #fff; color: #374151; transition: background 0.1s, border-color 0.1s; }
    .page-btn:hover { background: #f3f4f6; } .page-btn.active { background: #4f46e5; border-color: #4f46e5; color: #fff; } .page-btn:disabled { opacity: 0.4; cursor: default; }
    .empty { padding: 60px 20px; text-align: center; color: #9ca3af; font-size: 14px; }
  </style>
</head>
<body>
  <div id="app">
    <aside class="sidebar">
      <div class="sidebar-logo">&#9670; Analytics</div>
      <a href="/dashboard" class="nav-item"><span class="icon">&#9632;</span> Dashboard</a>
      <a href="/members" class="nav-item"><span class="icon">&#9651;</span> Members</a>
      <a href="/drivers" class="nav-item"><span class="icon">&#9654;</span> Drivers</a>
      <a href="/helpers" class="nav-item"><span class="icon">&#9670;</span> Helpers</a>
      <a href="/admin" class="nav-item active"><span class="icon">&#9733;</span> Admin</a>
      <a href="/settings" class="nav-item"><span class="icon">&#9881;</span> Settings</a>
    </aside>
    <main class="main">
      <div class="page-header">
        <div><div class="page-title">Admins</div><div class="page-subtitle">{{ filteredAdmins.length }} admin{{ filteredAdmins.length !== 1 ? 's' : '' }} found</div></div>
        <div class="toolbar"><div class="search-wrap"><span class="icon">&#9906;</span><input class="search-input" v-model="search" placeholder="Search admins…" type="text" /></div><button class="btn btn-primary">+ Add Admin</button></div>
      </div>
      <div class="card">
        <table>
          <thead><tr>
            <th @click="sortBy('name')" :class="{ sorted: sortKey === 'name' }">Admin <span class="sort-icon">{{ sortKey === 'name' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span></th>
            <th @click="sortBy('role')" :class="{ sorted: sortKey === 'role' }">Role <span class="sort-icon">{{ sortKey === 'role' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span></th>
            <th @click="sortBy('status')" :class="{ sorted: sortKey === 'status' }">Status <span class="sort-icon">{{ sortKey === 'status' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span></th>
            <th @click="sortBy('accessLevel')" :class="{ sorted: sortKey === 'accessLevel' }">Access Level <span class="sort-icon">{{ sortKey === 'accessLevel' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span></th>
            <th @click="sortBy('lastLogin')" :class="{ sorted: sortKey === 'lastLogin' }">Last Login <span class="sort-icon">{{ sortKey === 'lastLogin' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span></th>
            <th @click="sortBy('joined')" :class="{ sorted: sortKey === 'joined' }">Joined <span class="sort-icon">{{ sortKey === 'joined' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span></th>
            <th></th>
          </tr></thead>
          <tbody>
            <tr v-if="pagedAdmins.length === 0"><td colspan="7"><div class="empty">No admins match your search.</div></td></tr>
            <tr v-for="admin in pagedAdmins" :key="admin.id">
              <td><div class="admin-cell"><div class="avatar" :style="{ background: admin.color }">{{ initials(admin.name) }}</div><div><div class="admin-name">{{ admin.name }}</div><div class="admin-email">{{ admin.email }}</div></div></div></td>
              <td><span class="role-badge" :class="admin.role.toLowerCase().replace(' ','-')">{{ admin.role }}</span></td>
              <td><span class="badge" :class="'badge-'+admin.status.toLowerCase()">{{ admin.status }}</span></td>
              <td><div class="access-bar"><div class="access-track"><div class="access-fill" :style="{ width: admin.accessLevel+'%' }"></div></div><span class="access-label">{{ admin.accessLevel }}%</span></div></td>
              <td><div>{{ admin.lastLogin }}</div><div class="secondary-text">{{ admin.lastLoginTime }}</div></td>
              <td>{{ admin.joined }}</td>
              <td><button class="action-btn">&#9998;</button><button class="action-btn">&#10006;</button></td>
            </tr>
          </tbody>
        </table>
        <div class="table-footer">
          <span>Showing {{ pageStart }}–{{ pageEnd }} of {{ filteredAdmins.length }}</span>
          <div class="pagination"><button class="page-btn" :disabled="page===1" @click="page--">&#8249;</button><button v-for="p in totalPages" :key="p" class="page-btn" :class="{active:p===page}" @click="page=p">{{ p }}</button><button class="page-btn" :disabled="page===totalPages" @click="page++">&#8250;</button></div>
        </div>
      </div>
    </main>
  </div>
  <script>
    const { createApp, ref, computed } = Vue;
    const COLORS = ['#4f46e5','#0891b2','#059669','#d97706','#dc2626','#7c3aed','#db2777','#0284c7','#16a34a','#ca8a04','#9333ea','#0e7490'];
    const ADMINS = [
      { id:1,  name:'Daniel Carter',    email:'daniel@example.com',  role:'Super Admin', status:'Active',    accessLevel:100, lastLogin:'Today',       lastLoginTime:'9:14 AM',  joined:'Jan 5, 2024' },
      { id:2,  name:'Rachel Kim',       email:'rachel@example.com',  role:'Admin',       status:'Active',    accessLevel:85,  lastLogin:'Today',       lastLoginTime:'11:02 AM', joined:'Jan 18, 2024' },
      { id:3,  name:'Victor Osei',      email:'victor@example.com',  role:'Moderator',   status:'Active',    accessLevel:60,  lastLogin:'Yesterday',   lastLoginTime:'3:45 PM',  joined:'Feb 10, 2024' },
      { id:4,  name:'Hannah Brooks',    email:'hannah@example.com',  role:'Support',     status:'Active',    accessLevel:40,  lastLogin:'2 days ago',  lastLoginTime:'10:30 AM', joined:'Mar 3, 2024' },
      { id:5,  name:'Samuel Tran',      email:'samuel@example.com',  role:'Admin',       status:'Inactive',  accessLevel:85,  lastLogin:'1 week ago',  lastLoginTime:'2:15 PM',  joined:'Feb 27, 2024' },
      { id:6,  name:'Fatima Al-Hassan', email:'fatima@example.com',  role:'Moderator',   status:'Active',    accessLevel:60,  lastLogin:'Today',       lastLoginTime:'8:50 AM',  joined:'Mar 14, 2024' },
      { id:7,  name:'Chris Denton',     email:'chris@example.com',   role:'Support',     status:'Suspended', accessLevel:20,  lastLogin:'3 weeks ago', lastLoginTime:'4:00 PM',  joined:'Apr 2, 2024' },
      { id:8,  name:'Lin Mei',          email:'lin@example.com',     role:'Admin',       status:'Active',    accessLevel:85,  lastLogin:'Yesterday',   lastLoginTime:'1:20 PM',  joined:'Apr 19, 2024' },
      { id:9,  name:'Tom Nguyen',       email:'tom@example.com',     role:'Moderator',   status:'Active',    accessLevel:60,  lastLogin:'Today',       lastLoginTime:'10:05 AM', joined:'May 7, 2024' },
      { id:10, name:'Sara Mitchell',    email:'sara@example.com',    role:'Support',     status:'Active',    accessLevel:40,  lastLogin:'3 days ago',  lastLoginTime:'9:00 AM',  joined:'May 21, 2024' },
      { id:11, name:'Ben Adeyemi',      email:'ben@example.com',     role:'Admin',       status:'Active',    accessLevel:85,  lastLogin:'Today',       lastLoginTime:'7:45 AM',  joined:'Jun 3, 2024' },
      { id:12, name:'Chloe Dupont',     email:'chloe@example.com',   role:'Moderator',   status:'Inactive',  accessLevel:60,  lastLogin:'2 weeks ago', lastLoginTime:'5:30 PM',  joined:'Jun 17, 2024' },
    ].map((a,i) => ({ ...a, color: COLORS[i % COLORS.length] }));
    const PER_PAGE = 8;
    createApp({
      setup() {
        const search=ref(''); const sortKey=ref('name'); const sortDir=ref('asc'); const page=ref(1);
        function initials(name){return name.split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase();}
        function sortBy(key){if(sortKey.value===key){sortDir.value=sortDir.value==='asc'?'desc':'asc';}else{sortKey.value=key;sortDir.value='asc';}page.value=1;}
        const filteredAdmins=computed(()=>{const q=search.value.toLowerCase();const list=q?ADMINS.filter(a=>a.name.toLowerCase().includes(q)||a.email.toLowerCase().includes(q)||a.role.toLowerCase().includes(q)||a.status.toLowerCase().includes(q)):[...ADMINS];list.sort((a,b)=>{const av=a[sortKey.value]??'';const bv=b[sortKey.value]??'';if(typeof av==='number'&&typeof bv==='number'){return sortDir.value==='asc'?av-bv:bv-av;}return sortDir.value==='asc'?String(av).localeCompare(String(bv)):String(bv).localeCompare(String(av));});return list;});
        const totalPages=computed(()=>Math.max(1,Math.ceil(filteredAdmins.value.length/PER_PAGE)));
        const pagedAdmins=computed(()=>{const start=(page.value-1)*PER_PAGE;return filteredAdmins.value.slice(start,start+PER_PAGE);});
        const pageStart=computed(()=>filteredAdmins.value.length===0?0:(page.value-1)*PER_PAGE+1);
        const pageEnd=computed(()=>Math.min(page.value*PER_PAGE,filteredAdmins.value.length));
        return{search,sortKey,sortDir,page,filteredAdmins,pagedAdmins,totalPages,pageStart,pageEnd,initials,sortBy};
      },
    }).mount('#app');
  </script>
</body>
</html>
{% endraw %}
