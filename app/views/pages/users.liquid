---
slug: users
---
{% raw %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Users — Dashboard</title>
  <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f0f2f5;
      color: #1a1a2e;
      min-height: 100vh;
    }

    .sidebar {
      position: fixed;
      top: 0; left: 0;
      width: 220px;
      height: 100vh;
      background: #1a1a2e;
      padding: 32px 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .sidebar-logo {
      font-size: 18px;
      font-weight: 700;
      color: #fff;
      padding: 0 12px 24px;
      letter-spacing: -0.3px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 14px;
      color: #8892a4;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      text-decoration: none;
    }

    .nav-item:hover, .nav-item.active {
      background: #ffffff14;
      color: #fff;
    }

    .nav-item .icon { font-size: 16px; }

    .main {
      margin-left: 220px;
      padding: 40px;
      min-height: 100vh;
    }

    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 32px;
    }

    .page-title {
      font-size: 24px;
      font-weight: 700;
      color: #1a1a2e;
    }

    .page-subtitle {
      font-size: 14px;
      color: #6b7280;
      margin-top: 2px;
    }

    .toolbar {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .search-wrap {
      position: relative;
    }

    .search-wrap .icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: #9ca3af;
      font-size: 14px;
      pointer-events: none;
    }

    .search-input {
      padding: 8px 12px 8px 34px;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      font-size: 14px;
      color: #1a1a2e;
      background: #fff;
      width: 240px;
      outline: none;
      transition: border-color 0.15s;
    }

    .search-input:focus { border-color: #4f46e5; }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      border: none;
      transition: background 0.15s;
    }

    .btn-primary {
      background: #4f46e5;
      color: #fff;
    }

    .btn-primary:hover { background: #4338ca; }

    .card {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 1px 3px rgba(0,0,0,.06);
      overflow: hidden;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead th {
      padding: 12px 20px;
      text-align: left;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #9ca3af;
      background: #f9fafb;
      border-bottom: 1px solid #f3f4f6;
      cursor: pointer;
      user-select: none;
      white-space: nowrap;
    }

    thead th:hover { color: #4f46e5; }

    thead th .sort-icon {
      display: inline-block;
      margin-left: 4px;
      opacity: 0.4;
      font-size: 10px;
    }

    thead th.sorted .sort-icon { opacity: 1; color: #4f46e5; }

    tbody tr {
      border-bottom: 1px solid #f3f4f6;
      transition: background 0.1s;
    }

    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: #f9fafb; }

    td {
      padding: 14px 20px;
      font-size: 14px;
      color: #374151;
      vertical-align: middle;
    }

    .user-cell {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 600;
      color: #fff;
      flex-shrink: 0;
    }

    .user-name {
      font-weight: 500;
      color: #1a1a2e;
      font-size: 14px;
    }

    .user-email {
      font-size: 12px;
      color: #9ca3af;
      margin-top: 1px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
    }

    .badge-active   { background: #d1fae5; color: #065f46; }
    .badge-inactive { background: #f3f4f6; color: #6b7280; }
    .badge-pending  { background: #fef3c7; color: #92400e; }

    .role-badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 500;
      background: #ede9fe;
      color: #5b21b6;
    }

    .role-badge.admin  { background: #fee2e2; color: #991b1b; }
    .role-badge.editor { background: #dbeafe; color: #1e40af; }
    .role-badge.viewer { background: #f3f4f6; color: #374151; }

    .action-btn {
      background: none;
      border: none;
      cursor: pointer;
      color: #9ca3af;
      font-size: 16px;
      padding: 4px 6px;
      border-radius: 4px;
      transition: background 0.1s, color 0.1s;
    }

    .action-btn:hover { background: #f3f4f6; color: #4f46e5; }

    .table-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 20px;
      border-top: 1px solid #f3f4f6;
      font-size: 13px;
      color: #6b7280;
    }

    .pagination {
      display: flex;
      gap: 4px;
    }

    .page-btn {
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      border: 1px solid #e5e7eb;
      font-size: 13px;
      cursor: pointer;
      background: #fff;
      color: #374151;
      transition: background 0.1s, border-color 0.1s;
    }

    .page-btn:hover { background: #f3f4f6; }
    .page-btn.active { background: #4f46e5; border-color: #4f46e5; color: #fff; }
    .page-btn:disabled { opacity: 0.4; cursor: default; }

    .empty {
      padding: 60px 20px;
      text-align: center;
      color: #9ca3af;
      font-size: 14px;
    }

    .charts-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 28px;
    }

    .chart-card {
      background: #fff;
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 1px 3px rgba(0,0,0,.06);
    }

    .chart-title {
      font-size: 15px;
      font-weight: 600;
      color: #1a1a2e;
      margin-bottom: 4px;
    }

    .chart-desc {
      font-size: 13px;
      color: #9ca3af;
      margin-bottom: 20px;
    }

    .chart-wrap {
      position: relative;
      height: 220px;
    }

    .address-text {
      font-size: 13px;
      color: #6b7280;
    }
  </style>
</head>
<body>
  <div id="app">
    <aside class="sidebar">
      <div class="sidebar-logo">&#9670; Analytics</div>
      <a href="/dashboard" class="nav-item"><span class="icon">&#9632;</span> Dashboard</a>
      <a href="/reports"   class="nav-item"><span class="icon">&#9675;</span> Reports</a>
      <a href="/users"     class="nav-item active"><span class="icon">&#9651;</span> Users</a>
      <a href="/settings"  class="nav-item"><span class="icon">&#9670;</span> Settings</a>
    </aside>

    <main class="main">
      <div class="page-header">
        <div>
          <div class="page-title">Users</div>
          <div class="page-subtitle">{{ filteredUsers.length }} user{{ filteredUsers.length !== 1 ? 's' : '' }} found</div>
        </div>
        <div class="toolbar">
          <div class="search-wrap">
            <span class="icon">&#9906;</span>
            <input
              class="search-input"
              v-model="search"
              placeholder="Search users…"
              type="text"
            />
          </div>
          <button class="btn btn-primary">+ Invite User</button>
        </div>
      </div>

      <!-- Charts row -->
      <div class="charts-row">
        <div class="chart-card">
          <div class="chart-title">Users by City</div>
          <div class="chart-desc">Number of users per city</div>
          <div class="chart-wrap"><canvas ref="cityChart"></canvas></div>
        </div>
        <div class="chart-card">
          <div class="chart-title">Users by Country</div>
          <div class="chart-desc">Distribution across countries</div>
          <div class="chart-wrap"><canvas ref="countryChart"></canvas></div>
        </div>
      </div>

      <div class="card">
        <table>
          <thead>
            <tr>
              <th @click="sortBy('name')" :class="{ sorted: sortKey === 'name' }">
                User <span class="sort-icon">{{ sortKey === 'name' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th @click="sortBy('role')" :class="{ sorted: sortKey === 'role' }">
                Role <span class="sort-icon">{{ sortKey === 'role' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th @click="sortBy('status')" :class="{ sorted: sortKey === 'status' }">
                Status <span class="sort-icon">{{ sortKey === 'status' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th @click="sortBy('joined')" :class="{ sorted: sortKey === 'joined' }">
                Joined <span class="sort-icon">{{ sortKey === 'joined' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th @click="sortBy('city')" :class="{ sorted: sortKey === 'city' }">
                Address <span class="sort-icon">{{ sortKey === 'city' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th @click="sortBy('lastActive')" :class="{ sorted: sortKey === 'lastActive' }">
                Last Active <span class="sort-icon">{{ sortKey === 'lastActive' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tr v-if="pagedUsers.length === 0">
              <td colspan="7"><div class="empty">No users match your search.</div></td>
            </tr>
            <tr v-for="user in pagedUsers" :key="user.id">
              <td>
                <div class="user-cell">
                  <div class="avatar" :style="{ background: user.color }">{{ initials(user.name) }}</div>
                  <div>
                    <div class="user-name">{{ user.name }}</div>
                    <div class="user-email">{{ user.email }}</div>
                  </div>
                </div>
              </td>
              <td>
                <span class="role-badge" :class="user.role.toLowerCase()">{{ user.role }}</span>
              </td>
              <td>
                <span class="badge" :class="'badge-' + user.status.toLowerCase()">{{ user.status }}</span>
              </td>
              <td>{{ user.joined }}</td>
              <td>
                <div class="address-text">{{ user.city }}</div>
                <div class="user-email">{{ user.country }}</div>
              </td>
              <td>{{ user.lastActive }}</td>
              <td>
                <button class="action-btn" title="Edit">&#9998;</button>
                <button class="action-btn" title="Delete">&#10006;</button>
              </td>
            </tr>
          </tbody>
        </table>

        <div class="table-footer">
          <span>Showing {{ pageStart }}–{{ pageEnd }} of {{ filteredUsers.length }}</span>
          <div class="pagination">
            <button class="page-btn" :disabled="page === 1" @click="page--">&#8249;</button>
            <button
              v-for="p in totalPages" :key="p"
              class="page-btn" :class="{ active: p === page }"
              @click="page = p"
            >{{ p }}</button>
            <button class="page-btn" :disabled="page === totalPages" @click="page++">&#8250;</button>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const { createApp, ref, computed, onMounted } = Vue;

    const COLORS = ['#4f46e5','#0891b2','#059669','#d97706','#dc2626','#7c3aed','#db2777','#0284c7'];

    const USERS = [
      { id:1,  name:'Alice Johnson',   email:'alice@example.com',   role:'Admin',  status:'Active',   joined:'Jan 3, 2024',  lastActive:'Today',        city:'New York',    country:'USA' },
      { id:2,  name:'Bob Martinez',    email:'bob@example.com',     role:'Editor', status:'Active',   joined:'Feb 14, 2024', lastActive:'Yesterday',    city:'Los Angeles', country:'USA' },
      { id:3,  name:'Carol White',     email:'carol@example.com',   role:'Viewer', status:'Inactive', joined:'Mar 5, 2024',  lastActive:'2 weeks ago',  city:'London',      country:'UK' },
      { id:4,  name:'David Kim',       email:'david@example.com',   role:'Editor', status:'Active',   joined:'Mar 20, 2024', lastActive:'3 hours ago',  city:'Seoul',       country:'South Korea' },
      { id:5,  name:'Eva Gonzalez',    email:'eva@example.com',     role:'Viewer', status:'Pending',  joined:'Apr 1, 2024',  lastActive:'Never',        city:'Mexico City', country:'Mexico' },
      { id:6,  name:'Frank Lee',       email:'frank@example.com',   role:'Admin',  status:'Active',   joined:'Apr 10, 2024', lastActive:'Today',        city:'New York',    country:'USA' },
      { id:7,  name:'Grace Liu',       email:'grace@example.com',   role:'Editor', status:'Active',   joined:'May 2, 2024',  lastActive:'1 hour ago',   city:'Singapore',   country:'Singapore' },
      { id:8,  name:'Henry Brown',     email:'henry@example.com',   role:'Viewer', status:'Inactive', joined:'May 18, 2024', lastActive:'1 month ago',  city:'London',      country:'UK' },
      { id:9,  name:'Isla Scott',      email:'isla@example.com',    role:'Editor', status:'Active',   joined:'Jun 6, 2024',  lastActive:'Today',        city:'Sydney',      country:'Australia' },
      { id:10, name:'James Taylor',    email:'james@example.com',   role:'Viewer', status:'Pending',  joined:'Jun 22, 2024', lastActive:'Never',        city:'Los Angeles', country:'USA' },
      { id:11, name:'Karen Adams',     email:'karen@example.com',   role:'Admin',  status:'Active',   joined:'Jul 4, 2024',  lastActive:'2 hours ago',  city:'Toronto',     country:'Canada' },
      { id:12, name:'Liam Wilson',     email:'liam@example.com',    role:'Editor', status:'Active',   joined:'Jul 30, 2024', lastActive:'Yesterday',    city:'Sydney',      country:'Australia' },
    ].map((u, i) => ({ ...u, color: COLORS[i % COLORS.length] }));

    const PER_PAGE = 8;

    createApp({
      setup() {
        const search      = ref('');
        const sortKey     = ref('name');
        const sortDir     = ref('asc');
        const page        = ref(1);
        const cityChart    = ref(null);
        const countryChart = ref(null);

        function initials(name) {
          return name.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();
        }

        function sortBy(key) {
          if (sortKey.value === key) {
            sortDir.value = sortDir.value === 'asc' ? 'desc' : 'asc';
          } else {
            sortKey.value = key;
            sortDir.value = 'asc';
          }
          page.value = 1;
        }

        const filteredUsers = computed(() => {
          const q = search.value.toLowerCase();
          const list = q
            ? USERS.filter(u =>
                u.name.toLowerCase().includes(q) ||
                u.email.toLowerCase().includes(q) ||
                u.role.toLowerCase().includes(q)
              )
            : [...USERS];

          list.sort((a, b) => {
            const av = a[sortKey.value] ?? '';
            const bv = b[sortKey.value] ?? '';
            return sortDir.value === 'asc'
              ? av.localeCompare(bv)
              : bv.localeCompare(av);
          });
          return list;
        });

        const totalPages = computed(() => Math.max(1, Math.ceil(filteredUsers.value.length / PER_PAGE)));

        const pagedUsers = computed(() => {
          const start = (page.value - 1) * PER_PAGE;
          return filteredUsers.value.slice(start, start + PER_PAGE);
        });

        const pageStart = computed(() => filteredUsers.value.length === 0 ? 0 : (page.value - 1) * PER_PAGE + 1);
        const pageEnd   = computed(() => Math.min(page.value * PER_PAGE, filteredUsers.value.length));

        function buildCharts() {
          // City chart
          const cityCounts = {};
          USERS.forEach(u => { cityCounts[u.city] = (cityCounts[u.city] || 0) + 1; });
          const cityLabels = Object.keys(cityCounts);
          const cityValues = cityLabels.map(c => cityCounts[c]);

          new Chart(cityChart.value.getContext('2d'), {
            type: 'bar',
            data: {
              labels: cityLabels,
              datasets: [{ label: 'Users', data: cityValues,
                backgroundColor: '#e0e7ff', hoverBackgroundColor: '#4f46e5',
                borderRadius: 6, borderSkipped: false }],
            },
            options: {
              responsive: true, maintainAspectRatio: false,
              plugins: { legend: { display: false } },
              scales: {
                x: { grid: { display: false }, border: { display: false }, ticks: { color: '#9ca3af', font: { size: 11 } } },
                y: { border: { display: false }, grid: { color: '#f3f4f6' }, ticks: { color: '#9ca3af', stepSize: 1 } },
              },
            },
          });

          // Country chart
          const countryCounts = {};
          USERS.forEach(u => { countryCounts[u.country] = (countryCounts[u.country] || 0) + 1; });
          const countryLabels = Object.keys(countryCounts);
          const countryValues = countryLabels.map(c => countryCounts[c]);
          const palette = ['#4f46e5','#0891b2','#059669','#d97706','#dc2626','#7c3aed'];

          new Chart(countryChart.value.getContext('2d'), {
            type: 'bar',
            data: {
              labels: countryLabels,
              datasets: [{ label: 'Users', data: countryValues,
                backgroundColor: countryLabels.map((_, i) => palette[i % palette.length] + '33'),
                hoverBackgroundColor: countryLabels.map((_, i) => palette[i % palette.length]),
                borderRadius: 6, borderSkipped: false }],
            },
            options: {
              responsive: true, maintainAspectRatio: false,
              plugins: { legend: { display: false } },
              scales: {
                x: { grid: { display: false }, border: { display: false }, ticks: { color: '#9ca3af', font: { size: 11 } } },
                y: { border: { display: false }, grid: { color: '#f3f4f6' }, ticks: { color: '#9ca3af', stepSize: 1 } },
              },
            },
          });
        }

        onMounted(buildCharts);

        return { search, sortKey, sortDir, page, cityChart, countryChart, filteredUsers, pagedUsers, totalPages, pageStart, pageEnd, initials, sortBy };
      },
    }).mount('#app');
  </script>
</body>
</html>
{% endraw %}
