---
slug: dashboard
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard</title>
  <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f0f2f5;
      color: #1a1a2e;
      min-height: 100vh;
    }

    .sidebar {
      position: fixed;
      top: 0; left: 0;
      width: 220px;
      height: 100vh;
      background: #1a1a2e;
      padding: 32px 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .sidebar-logo {
      font-size: 18px;
      font-weight: 700;
      color: #fff;
      padding: 0 12px 24px;
      letter-spacing: -0.3px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 14px;
      color: #8892a4;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      text-decoration: none;
    }

    .nav-item:hover, .nav-item.active {
      background: #ffffff14;
      color: #fff;
    }

    .nav-item .icon { font-size: 16px; }

    .main {
      margin-left: 220px;
      padding: 40px;
      min-height: 100vh;
    }

    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 32px;
    }

    .page-title {
      font-size: 24px;
      font-weight: 700;
      color: #1a1a2e;
    }

    .page-subtitle {
      font-size: 14px;
      color: #6b7280;
      margin-top: 2px;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 32px;
    }

    .stat-card {
      background: #fff;
      border-radius: 12px;
      padding: 20px 24px;
      box-shadow: 0 1px 3px rgba(0,0,0,.06);
    }

    .stat-label {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: #9ca3af;
      margin-bottom: 8px;
    }

    .stat-value {
      font-size: 28px;
      font-weight: 700;
      color: #1a1a2e;
      line-height: 1;
    }

    .stat-change {
      font-size: 12px;
      margin-top: 6px;
      font-weight: 500;
    }

    .stat-change.up { color: #10b981; }
    .stat-change.down { color: #ef4444; }

    .chart-card {
      background: #fff;
      border-radius: 12px;
      padding: 28px;
      box-shadow: 0 1px 3px rgba(0,0,0,.06);
    }

    .chart-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 24px;
    }

    .chart-title {
      font-size: 16px;
      font-weight: 600;
      color: #1a1a2e;
    }

    .chart-desc {
      font-size: 13px;
      color: #9ca3af;
      margin-top: 2px;
    }

    .period-tabs {
      display: flex;
      gap: 4px;
      background: #f3f4f6;
      border-radius: 8px;
      padding: 4px;
    }

    .period-tab {
      padding: 5px 12px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 500;
      color: #6b7280;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      border: none;
      background: transparent;
    }

    .period-tab.active {
      background: #fff;
      color: #1a1a2e;
      box-shadow: 0 1px 3px rgba(0,0,0,.1);
    }

    .chart-wrap {
      position: relative;
      height: 320px;
    }
  </style>
</head>
<body>
  <div id="app">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-logo">&#9670; Analytics</div>
      <a href="/dashboard" class="nav-item active"><span class="icon">&#9632;</span> Dashboard</a>
      <a href="/reports"   class="nav-item"><span class="icon">&#9675;</span> Reports</a>
      <a href="/users"     class="nav-item"><span class="icon">&#9651;</span> Users</a>
      <a href="/settings"  class="nav-item"><span class="icon">&#9670;</span> Settings</a>
    </aside>

    <!-- Main content -->
    <main class="main">
      <div class="page-header">
        <div>
          <div class="page-title">Dashboard</div>
          <div class="page-subtitle">Welcome back — here's what's happening.</div>
        </div>
      </div>

      <!-- Stat cards -->
      <div class="stats-grid">
        <div class="stat-card" v-for="stat in stats" :key="stat.label">
          <div class="stat-label">{{ stat.label }}</div>
          <div class="stat-value">{{ stat.value }}</div>
          <div class="stat-change" :class="stat.trend">{{ stat.change }}</div>
        </div>
      </div>

      <!-- Bar chart -->
      <div class="chart-card">
        <div class="chart-header">
          <div>
            <div class="chart-title">Monthly Revenue</div>
            <div class="chart-desc">Total revenue broken down by month</div>
          </div>
          <div class="period-tabs">
            <button
              v-for="p in periods"
              :key="p"
              class="period-tab"
              :class="{ active: activePeriod === p }"
              @click="setPeriod(p)"
            >{{ p }}</button>
          </div>
        </div>
        <div class="chart-wrap">
          <canvas ref="chartCanvas"></canvas>
        </div>
      </div>
    </main>
  </div>

  <script>
    const { createApp, ref, onMounted, watch, nextTick } = Vue;

    const DATA = {
      '6M': {
        labels: ['Nov', 'Dec', 'Jan', 'Feb', 'Mar', 'Apr'],
        values: [38000, 52000, 41000, 60000, 55000, 71000],
      },
      '1Y': {
        labels: ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar', 'Apr'],
        values: [28000, 33000, 30000, 36000, 41000, 38000, 38000, 52000, 41000, 60000, 55000, 71000],
      },
      'YTD': {
        labels: ['Jan', 'Feb', 'Mar', 'Apr'],
        values: [41000, 60000, 55000, 71000],
      },
    };

    createApp({
      setup() {
        const chartCanvas = ref(null);
        const activePeriod = ref('1Y');
        const periods = ['YTD', '6M', '1Y'];
        let chartInstance = null;

        const stats = [
          { label: 'Total Revenue', value: '$227K',  change: '↑ 12.4% vs last period', trend: 'up' },
          { label: 'New Users',     value: '3,842',  change: '↑ 8.1% vs last period',  trend: 'up' },
          { label: 'Avg Order',     value: '$59.10', change: '↓ 2.3% vs last period',  trend: 'down' },
          { label: 'Churn Rate',    value: '1.8%',   change: '↓ 0.4% vs last period',  trend: 'up' },
        ];

        function buildChart() {
          if (chartInstance) chartInstance.destroy();
          const { labels, values } = DATA[activePeriod.value];
          const ctx = chartCanvas.value.getContext('2d');

          chartInstance = new Chart(ctx, {
            type: 'bar',
            data: {
              labels,
              datasets: [{
                label: 'Revenue',
                data: values,
                backgroundColor: labels.map((_, i) =>
                  i === labels.length - 1 ? '#4f46e5' : '#e0e7ff'
                ),
                borderRadius: 6,
                borderSkipped: false,
              }],
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { display: false },
                tooltip: {
                  callbacks: {
                    label: ctx => ' $' + ctx.parsed.y.toLocaleString(),
                  },
                },
              },
              scales: {
                x: {
                  grid: { display: false },
                  border: { display: false },
                  ticks: { color: '#9ca3af', font: { size: 12 } },
                },
                y: {
                  border: { display: false },
                  grid: { color: '#f3f4f6' },
                  ticks: {
                    color: '#9ca3af',
                    font: { size: 12 },
                    callback: v => '$' + (v / 1000) + 'k',
                  },
                },
              },
            },
          });
        }

        function setPeriod(p) {
          activePeriod.value = p;
          nextTick(buildChart);
        }

        onMounted(buildChart);
        return { chartCanvas, stats, periods, activePeriod, setPeriod };
      },
    }).mount('#app');
  </script>
</body>
</html>
